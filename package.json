{
  "name": "local-code-search",
  "displayName": "local-code-search",
  "description": "Search your codebase by meaning, entirely locally",
  "publisher": "AryanJadhav",
  "repository": {
  "type": "git",
  "url": "https://github.com/omujadhav/local-code-search-vscode.git"
  },
  "icon": "icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "local-code-search.search",
        "title": "Local Code Search: Search Codebase"
      },
      {
        "command": "local-code-search.index",
        "title": "Local Code Search: Index Workspace"
      }
    ],
    "configuration": {
      "title": "Local Code Search",
      "properties": {
        "localCodeSearch.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to your Python executable (with dependencies installed)."
        },
        "localCodeSearch.mainScriptPath": {
          "type": "string",
          "default": "",
          "description": "Full path to your local-code-search project's src/main.py"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
